{
  "name": "ecov-charge",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:expo-go": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:compat": "node ./node_modules/typescript/bin/tsc --noEmit",
    "backtest": "bun run scripts/backtest-charging.ts",
    "test": "bun test",
    "server:dev": "cd apps/server && go run ./cmd/api",
    "server:test": "cd apps/server && go test ./...",
    "server:check": "cd apps/server && gofmt -l . && go vet ./... && go test ./...",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "@expo/ui": "0.2.0-beta.9",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.31.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "~5.9.2"
  },
  "packageManager": "bun@1.3.14"
}
